<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for devices running Android 11 (API level 30) or lower.
     Referenced by android:fullBackupContent in AndroidManifest.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>