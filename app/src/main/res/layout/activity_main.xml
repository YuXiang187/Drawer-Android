<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:menu="@menu/main_app_bar"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingBottom="@dimen/main_content_bottom_compensation">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Drawer.SectionHeader"
                android:text="@string/functions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_s"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_s">

                <Button
                    android:id="@+id/draw_btn"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_draw" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Drawer.SectionHeader"
                android:text="@string/settings" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/start_on_boot_switch"
                style="@style/Widget.Drawer.SettingSwitch"
                android:checked="false"
                android:text="@string/settings_start_on_boot" />

            <View style="@style/Widget.Drawer.ListDivider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/float_switch"
                style="@style/Widget.Drawer.SettingSwitch"
                android:checked="false"
                android:text="@string/settings_float_button" />

            <View style="@style/Widget.Drawer.ListDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_item_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_location_switch"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/reset_location_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_reset_location"
                    android:padding="@dimen/spacing_m"
                    android:src="@drawable/ic_reset" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/location_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:contentDescription="@string/settings_location_switch" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Drawer.SectionHeader"
                android:text="@string/lists" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_s"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_s">

                <Button
                    android:id="@+id/edit_btn"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_m"
                    android:text="@string/lists_edit" />

                <Button
                    android:id="@+id/stat_btn"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lists_statistics" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>